{
  "name": "excel_automation",
  "version": "1.0.0",
  "description": "Automate Excel spreadsheet operations using openpyxl.",
  "category": "office",
  "risk": "LOW",
  "permissions": ["files.read", "files.write"],
  "inputs": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["create", "read"]
      },
      "filepath": {
        "type": "string"
      },
      "sheet_name": {
        "type": "string"
      },
      "data": {
        "type": "array"
      }
    },
    "required": ["action", "filepath"]
  },
  "outputs": {
    "type": "object",
    "properties": {
      "success": {"type": "boolean"},
      "summary": {"type": "string"}
    }
  }
}
