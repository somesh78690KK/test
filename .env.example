# T.A.R.O. Environment Variables
# Copy this to .env and fill in your values.
# Never commit .env to version control.

# --- Ollama ---
OLLAMA_HOST=127.0.0.1:11434

# --- Cloud Providers (all disabled by default) ---
# Only fill in keys for providers you intend to use.
# Set TARO_*_ENABLED=true in config.local.yaml to enable a provider.
TARO_GEMINI_API_KEY=
TARO_OPENAI_API_KEY=
TARO_GROQ_API_KEY=
TARO_ANTHROPIC_API_KEY=

# --- Optional services ---
TARO_GOOGLE_STT_KEY=
